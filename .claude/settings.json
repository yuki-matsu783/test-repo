{
  "env": {
    "CCNAVI_MODE": "enable",
    "CCNAVI_ENTRY_PATH": ".ccnavi/scripts/ccnavi-launcher.sh",
    "CCNAVI_RESTORE_IF_DENY": "enable",
    "CCNAVI_GUARD_CORE_FILES": "enable",
    "CCNAVI_GUARD_TICKET_APPROVAL": "enable",
    "CCNAVI_GUARD_UNWATCHED": "enable",
    "CCNAVI_TICKET_CONTROL": "enable"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/${CCNAVI_ENTRY_PATH}\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR}/.ccnavi/scripts/ccnavi-session-start.sh\"",
            "timeout": 60
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/${CCNAVI_ENTRY_PATH}\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR}/.ccnavi/scripts/ccnavi-idle.sh\" reset",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/${CCNAVI_ENTRY_PATH}\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/${CCNAVI_ENTRY_PATH}\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/${CCNAVI_ENTRY_PATH}\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/${CCNAVI_ENTRY_PATH}\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR}/.ccnavi/scripts/ccnavi-idle.sh\" notice",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR}/.ccnavi/scripts/ccnavi-idle.sh\" start",
            "timeout": 3600,
            "asyncRewake": true
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/${CCNAVI_ENTRY_PATH}\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/${CCNAVI_ENTRY_PATH}\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
